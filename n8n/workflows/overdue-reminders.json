{
  "id": "lendloopOverdue01",
  "name": "LendLoop – Overdue reminders",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 8
            }
          ]
        }
      },
      "id": "5cc88519-e3a8-4a46-aeb4-d3372cc30a57",
      "name": "Every day at 08:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        200
      ]
    },
    {
      "parameters": {},
      "id": "23a63157-77f3-4170-9186-3af2e8cb916b",
      "name": "Run manually",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        400
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Signs a request to Convex: hex(HMAC_SHA256(secret, timestamp + \".\" + body)).\n// The secret comes from the container env, so this export never contains it.\nconst crypto = require('crypto');\nfunction signed(body) {\n  const secret = $env.LENDLOOP_INBOUND_SECRET;\n  if (!secret) throw new Error('LENDLOOP_INBOUND_SECRET is not set');\n  const timestamp = String(Math.floor(Date.now() / 1000));\n  const signature = crypto.createHmac('sha256', secret).update(timestamp + '.' + body).digest('hex');\n  return { body, timestamp, signature, eventId: crypto.randomUUID() };\n}\n\n// GET has an empty body, so the signature covers timestamp + \".\".\nreturn [{ json: { signed: signed('') } }];"
      },
      "id": "291181df-d548-42b3-9a99-a026aadaed5f",
      "name": "Sign request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.LENDLOOP_CONVEX_SITE_URL }}/n8n/overdue-loans",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-LendLoop-Timestamp",
              "value": "={{ $json.signed.timestamp }}"
            },
            {
              "name": "X-LendLoop-Signature",
              "value": "={{ $json.signed.signature }}"
            },
            {
              "name": "X-LendLoop-Event-Id",
              "value": "={{ $json.signed.eventId }}"
            }
          ]
        },
        "options": {
          "timeout": 15000
        }
      },
      "id": "c7f53033-1a20-4c29-ba70-9adeaf7b7b12",
      "name": "Fetch overdue loans",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "fieldToSplitOut": "loans",
        "options": {}
      },
      "id": "afb8d3ae-79d3-4871-9c4a-84ebaecd2e00",
      "name": "One item per loan",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "fca80365-cc5e-4751-bb74-89bf97ca6b2b",
              "leftValue": "={{ $json.remindedToday }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "false",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "0ec7ebce-a380-4178-aa2b-10425fb5701c",
      "name": "Not reminded today?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        880,
        300
      ]
    },
    {
      "parameters": {
        "fromEmail": "={{ $env.LENDLOOP_FROM_EMAIL }}",
        "toEmail": "={{ $json.recipientEmail }}",
        "subject": "=Reminder: the {{ $json.toolName }} is overdue",
        "emailFormat": "text",
        "text": "=Hi {{ $json.recipientName }},\n\nFriendly reminder: the {{ $json.toolName }} you borrowed was due back on {{ $json.endDate }}.\n\nPlease arrange to return it to its owner. Thanks for keeping the loop going!\n{{ $env.LENDLOOP_APP_URL }}/my-requests\n\n– LendLoop",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "2e00c36a-0345-480d-b47c-51610559a3ef",
      "name": "Email reminder",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1100,
        300
      ],
      "credentials": {
        "smtp": {
          "id": "lendloopSmtp0001",
          "name": "LendLoop SMTP"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Signs a request to Convex: hex(HMAC_SHA256(secret, timestamp + \".\" + body)).\n// The secret comes from the container env, so this export never contains it.\nconst crypto = require('crypto');\nfunction signed(body) {\n  const secret = $env.LENDLOOP_INBOUND_SECRET;\n  if (!secret) throw new Error('LENDLOOP_INBOUND_SECRET is not set');\n  const timestamp = String(Math.floor(Date.now() / 1000));\n  const signature = crypto.createHmac('sha256', secret).update(timestamp + '.' + body).digest('hex');\n  return { body, timestamp, signature, eventId: crypto.randomUUID() };\n}\n\n// One item per loan. The error output of the email node carries an \"error\" field.\nconst loan = $('Not reminded today?').item.json;\nconst failed = 'error' in $json;\nconst body = JSON.stringify({\n  idempotencyKey: loan.idempotencyKey,\n  loanId: loan.loanId,\n  type: 'overdue_reminder',\n  status: failed ? 'failed' : 'sent',\n});\nreturn { json: { signed: signed(body) } };"
      },
      "id": "9ca4f7f5-9516-4076-b907-071387d35076",
      "name": "Sign write-back",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.LENDLOOP_CONVEX_SITE_URL }}/n8n/automation-event",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-LendLoop-Timestamp",
              "value": "={{ $json.signed.timestamp }}"
            },
            {
              "name": "X-LendLoop-Signature",
              "value": "={{ $json.signed.signature }}"
            },
            {
              "name": "X-LendLoop-Event-Id",
              "value": "={{ $json.signed.eventId }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.signed.body }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "c87046d0-0530-448c-8a6b-67cf5c0fe2c0",
      "name": "Write back to Convex",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    }
  ],
  "connections": {
