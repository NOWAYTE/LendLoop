        "mode": "runOnceForAllItems",
        "jsCode": "// Verifies a request from Convex. Rejects (valid: false) unless:\n//   X-LendLoop-Signature == hex(HMAC_SHA256(LENDLOOP_OUTBOUND_SECRET, timestamp + \".\" + rawBody))\n//   and X-LendLoop-Timestamp is within 5 minutes (replay protection).\n// Compared with crypto.timingSafeEqual. No headers, body or emails are logged.\nconst crypto = require('crypto');\nconst item = $input.first();\nconst headers = item.json.headers || {};\nconst secret = $env.LENDLOOP_OUTBOUND_SECRET;\nconst timestamp = String(headers['x-lendloop-timestamp'] || '');\nconst signature = String(headers['x-lendloop-signature'] || '').toLowerCase();\n\n// \"Raw Body\" is on in the webhook, so the exact bytes Convex signed arrive as binary.\n// Fallback: Convex sends compact JSON.stringify output, which re-serialising reproduces.\nlet rawBody;\nif (item.binary && item.binary.data) {\n  rawBody = (await this.helpers.getBinaryDataBuffer(0, 'data')).toString('utf8');\n} else {\n  rawBody = JSON.stringify(item.json.body);\n}\n\nconst now = Math.floor(Date.now() / 1000);\nconst fresh = /^\\d{1,12}$/.test(timestamp) && Math.abs(now - Number(timestamp)) <= 300;\nlet valid = false;\nif (secret && fresh && /^[0-9a-f]{64}$/.test(signature)) {\n  const expected = crypto.createHmac('sha256', secret).update(timestamp + '.' + rawBody).digest('hex');\n  valid = crypto.timingSafeEqual(Buffer.from(expected, 'utf8'), Buffer.from(signature, 'utf8'));\n}\n\nlet payload = null;\nif (valid) {\n  try {\n    payload = JSON.parse(rawBody);\n  } catch (e) {\n    valid = false;\n  }\n}\n// Shape check: only the minimal fields Convex sends.\nif (valid && !(payload && ['created', 'status_changed'].includes(payload.type) &&\n    typeof payload.eventId === 'string' && typeof payload.recipientEmail === 'string')) {\n  valid = false;\n  payload = null;\n}\nreturn [{ json: { valid, payload } }];"
      },
