    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Signs a request to Convex: hex(HMAC_SHA256(secret, timestamp + \".\" + body)).\n// The secret comes from the container env, so this export never contains it.\nconst crypto = require('crypto');\nfunction signed(body) {\n  const secret = $env.LENDLOOP_INBOUND_SECRET;\n  if (!secret) throw new Error('LENDLOOP_INBOUND_SECRET is not set');\n  const timestamp = String(Math.floor(Date.now() / 1000));\n  const signature = crypto.createHmac('sha256', secret).update(timestamp + '.' + body).digest('hex');\n  return { body, timestamp, signature, eventId: crypto.randomUUID() };\n}\n\n// Runs after either email node: the error output carries an \"error\" field.\nconst payload = $('Verify signature').first().json.payload;\nconst failed = 'error' in $input.first().json;\nconst body = JSON.stringify({\n  idempotencyKey: 'notify:' + payload.eventId,\n  loanId: payload.loanId,\n  type: 'request_notification',\n  status: failed ? 'failed' : 'sent',\n});\nreturn [{ json: { emailStatus: failed ? 'failed' : 'sent', signed: signed(body) } }];"
      },
